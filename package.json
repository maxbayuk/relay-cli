{
  "name": "@relay-protocol/cli",
  "version": "0.1.0",
  "description": "AI-native CLI for Relay Protocol API — dynamically built from OpenAPI spec",
  "type": "module",
  "bin": {
    "relay": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "start": "node dist/cli.js",
    "test": "vitest run test/validator.test.ts test/formatter.test.ts test/spec-loader.test.ts",
    "test:smoke": "vitest run test/smoke.test.ts test/chain-resolver.test.ts",
    "test:all": "vitest run",
    "validate-catalog": "tsx scripts/validate-catalog.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/",
    "agent-docs/"
  ],
  "dependencies": {
    "commander": "^13.1.0",
    "jmespath": "^0.16.0"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  }
}
